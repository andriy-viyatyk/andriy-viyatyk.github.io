---
/**
 * A short, silent demo clip that starts by itself and loops. `src` is a media file name from the
 * `media` release, e.g. "persephone-demo.gif".
 *
 * A .gif renders as an image, which the site prefers: it plays at once and needs no player. An .mp4
 * still renders as a looping video (pass `controls` for one the reader should pause and seek).
 */
interface Props {
	src: string;
	poster?: string;
	caption?: string;
	controls?: boolean;
}

const { src, poster, caption, controls = false } = Astro.props;
const media = (name: string) => (name.startsWith('/') || name.includes('://') ? name : `/media/${name}`);
const isGif = src.toLowerCase().endsWith('.gif');
---

<figure class="demo-clip">
	{
		isGif ? (
			<img src={media(src)} alt={caption ?? ''} width="960" height="720" decoding="async" />
		) : (
			<video
				src={media(src)}
				poster={poster ? media(poster) : undefined}
				autoplay={!controls}
				loop={!controls}
				muted
				playsinline
				controls={controls}
				preload="metadata"
				aria-label={caption}
			/>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.demo-clip {
		margin: 1.5rem 0;
	}
	.demo-clip img,
	.demo-clip video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.demo-clip figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
