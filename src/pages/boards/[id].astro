---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import DemoClip from '../../components/DemoClip.astro';
import { type Board, loadBoards, screenshotUrl, sourceUrl } from '../../lib/boards';

// A board listed here shows a demo clip (from the `media` release) instead of the
// screenshot its manifest names. The catalog data comes from persephone-boards; the clips are ours.
const demoClips: Record<string, { src: string; caption: string }> = {
	'torrent-viewer': {
		src: 'persephone-torrent-demo.mp4',
		caption: 'A magnet link from a web page opens in the Torrent Viewer; the film streams into the video player while it downloads',
	},
	'theme-editor': {
		src: 'persephone-theme-editor-demo.mp4',
		caption: 'Create a theme from Settings: pick one of 100 generated themes, fine-tune its base colors, and save it as your own',
	},
};

export async function getStaticPaths() {
	const boards = await loadBoards();
	return boards.map((board) => ({ params: { id: board.id }, props: { board } }));
}

const { board } = Astro.props as { board: Board };
// Longer, site-only notes for a board, shown under its clip or screenshot. The manifest's
// one-line description (also shown in Persephone's catalog) stays short.
const boardDetails: Record<string, { heading: string; html: string }> = {
	'torrent-viewer': {
		heading: 'More than a torrent downloader',
		html: `<p>Torrent Viewer also adds a <strong>content provider</strong> to Persephone. It registers the
<code>magnet:</code> and <code>torrent:</code> link schemes, so every file inside a torrent gets its own link,
such as <code>torrent://&lt;info-hash&gt;/&lt;path&gt;</code>.</p>
<p>Persephone's editors and other boards read that link like any other source in the content pipe.
The bytes stream straight from the swarm, piece by piece, as the reader asks for them:</p>
<ul>
<li>the video player starts playing before the download finishes, and seeking fetches only the part it jumps to;</li>
<li>an image, PDF or text file opens in its usual editor or viewer board, with no copy on disk;</li>
<li>downloaded pieces stay in memory. A file is saved only when you choose <em>Download this file</em>.</li>
</ul>
<p>Magnet links from web pages, <code>.torrent</code> files and <code>.torrent</code> download links all open in the board.
The status bar of a page that is reading a torrent shows its live peers and download speed.</p>`,
	},
	'claude-agent': {
		heading: 'An agent that lives inside Persephone',
		html: `<p>Agent Chat is a chat page for the <strong>Claude Code</strong> and <strong>Codex</strong> command line
applications you already have installed. Each one signs in with your own account, and the board never touches your
credentials. Choose the engine, model and effort for each new chat. Sessions from both engines share one sidebar,
grouped by working folder.</p>
<ul>
<li><strong>Knows Persephone from the start.</strong> The board ships instructions that tell the agent it is working
inside Persephone. Before it asks you to paste anything, it reads the pages you have open: the active page, the
page beside it, a screenshot you pasted. You can edit these instructions for each engine.</li>
<li><strong>Works with Persephone without any setup.</strong> Each chat gets its own private Persephone MCP endpoint,
so the agent can read and drive your pages, the browser and boards even when Persephone's MCP server setting is off.
The endpoint is revoked when the session ends.</li>
<li><strong>Group chats.</strong> Invite more agents into a conversation: a reviewer, a critic, a researcher, a
developer, or a profile of your own. Claude and Codex agents can work in the same chat. Each agent keeps its own
session and model and sees the shared timeline. Every post carries its author's badge, and the main agent
moderates.</li>
<li><strong>The terminal's features in a chat page.</strong>
<ul>
<li>Auto, Plan and Bypass permission modes, with approval cards</li>
<li>slash commands, plus <code>/mcp</code> and <code>/context</code> panels</li>
<li>subagent transcripts, and several sessions running side by side</li>
<li>usage limits and cost</li>
<li>it can follow and resume sessions you started in a terminal</li>
</ul></li>
<li><strong>Voice input.</strong> With the Speech to Text board installed, the microphone button dictates into the
message box.</li>
</ul>
<p>Agent Chat also provides the <code>agent.session</code> service, so other boards can open agent sessions through it.</p>`,
	},
	translate: {
		heading: 'Translation for all of Persephone',
		html: `<p>Translate runs Firefox's translation models on your computer and detects the source language for you.
You download each language direction once, with a click. After that, translation works offline, and your text
never leaves the computer. A pair without a direct model is translated through English.</p>
<p>The board's own page translates pasted text. Installing it also adds translation to Persephone itself:</p>
<ul>
<li><strong>Browser:</strong> the Translate button on the browser toolbar translates the web page in place.
One click restores the original text.</li>
<li><strong>Text Editor:</strong> translate a selection or the whole page into a new tab.</li>
<li><strong>Other boards</strong> can use the <code>text.translate</code> service for plain text or HTML.</li>
</ul>
<p>When a translation needs a model you have not downloaded yet, Persephone asks before downloading anything.</p>`,
	},
	'speech-to-text': {
		heading: 'Local speech recognition for all of Persephone',
		html: `<p>Speech to Text runs OpenAI's <strong>Whisper</strong> models on your own computer through
<a href="https://github.com/ggml-org/whisper.cpp">whisper.cpp</a>, and your audio is never uploaded. Whisper was trained on a very
large amount of multilingual speech, so it copes well with accents and non-native speakers. Choose a model by
speed and accuracy, from Base up to Large v3 Turbo, and turn on GPU acceleration if your computer has a suitable
graphics card.</p>
<p>Installing the board adds speech input to Persephone itself:</p>
<ul>
<li><strong>Voice typing:</strong> press <code>Alt+V</code> (or a tap of the right <code>Ctrl</code> key, if you set
that up) and dictate into whatever input has focus.</li>
<li><strong>Transcripts in the Text Editor:</strong> record your microphone, the computer's audio, or both, for
calls, meetings or videos. Text is added to the page as people speak. In <em>Both</em> mode, lines are labeled
<em>Me</em> and <em>Others</em>.</li>
<li><strong>Agent Chat:</strong> dictate prompts with the microphone button.</li>
</ul>
<p>Short phrases are recognized more accurately when you list the languages you speak in the board's settings. A
vocabulary prompt helps with names and technical terms. Other boards can use the <code>speech.transcribe</code>
service.</p>`,
	},
};
const details = boardDetails[board.id];
const demo = demoClips[board.id];
const screenshot = demo ? undefined : screenshotUrl(board);
// A board with a demo clip uses the clip's poster as its link-preview image.
const head = [
	{ tag: 'title' as const, content: `${board.name} – a Persephone board` },
	...(demo ? [{ tag: 'meta' as const, attrs: { property: 'og:image', content: `https://andriy-viyatyk.github.io/media/${demo.src.replace(/\.[^.]+$/, '.jpg')}` } }] : []),
];
const sizeKb = Math.round(board.archive.size / 1024);
---

<StarlightPage frontmatter={{ title: board.name, description: board.description, head }}>
	<p>{board.description}</p>

	{demo && <DemoClip src={demo.src} caption={demo.caption} />}
	{screenshot && <img class="board-screenshot" src={screenshot} alt={`${board.name} in Persephone`} width="1120" height="700" />}

	{details && (
		<>
			<h2>{details.heading}</h2>
			<Fragment set:html={details.html} />
		</>
	)}

	<table>
		<tbody>
			{board.fileMasks && (
				<tr>
					<th>Opens</th>
					<td><code>{board.fileMasks.join(', ')}</code></td>
				</tr>
			)}
			<tr>
				<th>Version</th>
				<td>{board.version}</td>
			</tr>
			{board.minAppVersion && (
				<tr>
					<th>Needs Persephone</th>
					<td>{board.minAppVersion} or later</td>
				</tr>
			)}
			<tr>
				<th>Download size</th>
				<td>{sizeKb} KB</td>
			</tr>
		</tbody>
	</table>

	<h2>Install</h2>
	<p>
		{board.fileMasks?.length
			? <>Open a matching file in Persephone: the editor switch offers to install <strong>{board.name}</strong>. You can also install it from the Published Boards catalog.</>
			: <>Install <strong>{board.name}</strong> from Persephone's Published Boards catalog.</>}
		{' '}The board is downloaded, checked against its published checksum, and runs only after you trust it.
	</p>

	<p>
		<a href={sourceUrl(board)}>Source on GitHub</a> · <a href="/boards/">All boards</a>
	</p>
</StarlightPage>

<style>
	/* Framed and spaced like a DemoClip, so pages with a screenshot match pages with a clip. */
	.board-screenshot {
		margin-bottom: 4rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
</style>
